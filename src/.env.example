# =============================================================================
# Clin.IQ - Environment Variables Template
# Copy this file to .env and configure for your environment.
# NEVER commit the .env file with real secrets.
# =============================================================================

# Server Configuration
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database Configuration (Uses local SQLite by default)
DATABASE_PATH=backend/data/cliniq.db

# Optional AI / External Integrations
# IBM watsonx.ai (Optional extension)
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# External Drug Interaction API (Optional fallback for RxNav / NLM)
RXNAV_API_BASE=https://rxnav.nlm.nih.gov/REST
